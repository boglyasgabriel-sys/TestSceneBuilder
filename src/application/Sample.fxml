<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.BorderPane?>

<BorderPane xmlns="http://javafx.com/javafx/8.0.111" xmlns:fx="http://javafx.com/fxml/1" fx:controller="application.SampleController">
   <bottom>
      <BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="400.0" BorderPane.alignment="CENTER">
         <bottom>
            <Button fx:id="monBouton" mnemonicParsing="false" onAction="#Lancer" text="Afficher" translateY="-10.0" BorderPane.alignment="CENTER" />
         </bottom>
         <top>
            <PieChart fx:id="monPieChart" maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="350.0" prefWidth="400.0" BorderPane.alignment="TOP_CENTER" />
         </top>
      </BorderPane>
   </bottom>
</BorderPane>